# Multi-server config — edit config.json "servers" array to add/remove servers.
# Environment variables below override config.json for single-server hosting platforms
# (e.g. Railway/Render). For multi-server, deploy separate instances or use config.json directly.

# Server 1 overrides (optional)
MC_HOST=upland-fairground.play.hosting
